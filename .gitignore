*.mdb.meta
sysinfo.txt
crashlytics-build.properties
/[Aa]ssets/[Ss]treamingAssets/aa/*
/[Aa]ssets/Plugins/Editor/JetBrains*

# Build outputs (incl. generated Xcode projects)
*.apk
*.aab
*.unitypackage
*.app
*.ipa
*.xcarchive
*.dSYM.zip
*.dSYM
/[Xx]code*/
/iOSBuild*/

# Signing / secrets: never commit
*.p12
*.pfx
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.keystore
*.jks
*.pem
*.key
*.p8
.env
.env.*
