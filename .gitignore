# OS
.DS_Store
Thumbs.db

# Generated by the Performance Testing package during test runs
/[Aa]ssets/[Rr]esources/PerformanceTestRun*

# ---- Local-only records: never commit (docs/COMMIT_SAFETY.md) ----
# Device verification code and generated recovery data (contains real settings data)
/[Aa]ssets/Game/Verification/
/[Aa]ssets/Game/Verification.meta
# Local-only copies anywhere: name them *.local.* or put them in a local/ folder
*.local.*
**/local/
# Incident records of 2026-10-28 with device identifiers, file lists and settings data
# (originals kept outside the repository; public summary: docs/recovery/IOS_DATA_INCIDENT_20261028.md)
/docs/recovery/IOS_DATA_RECOVERY_PLAN_20261028.md
/docs/recovery/IOS_DEVICE_RECOVERY_RUNBOOK_20261028.md
/docs/recovery/IOS_DATA_RECOVERY_MANIFEST_20261028.tsv

# Python caches
__pycache__/
*.py[co]
